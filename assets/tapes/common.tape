# Demo GIFs. Run from the repo root inside a sling-configured nvim setup, e.g.
#   vhs assets/tapes/model.tape
# Needs tmux, claude and JetBrainsMono Nerd Font.
Set Shell zsh
Set Width 1280
Set Height 727
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 13
Set LineHeight 1.1
Set Padding 8
Set Framerate 20
Set TypingSpeed 60ms
Set CursorBlink false
Set Theme { "name": "chris", "background": "#1a1a1a", "foreground": "#e0e0e0", "cursor": "#ff69b4", "selection": "#ff69b4", "black": "#3c3c3c", "red": "#ff6b6b", "green": "#8fb28f", "yellow": "#f4d35e", "blue": "#7fb2c7", "magenta": "#ff69b4", "purple": "#ff69b4", "cyan": "#74c5c4", "white": "#f5f5f5", "brightBlack": "#808080", "brightRed": "#ff8787", "brightGreen": "#a8d4a8", "brightYellow": "#ffe066", "brightBlue": "#9fd5e8", "brightMagenta": "#ff1493", "brightPurple": "#ff1493", "brightCyan": "#8ee5e3", "brightWhite": "#ffffff" }
